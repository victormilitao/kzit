{
  "name": "kzit",
  "version": "2.0.0",
  "description": "Sistema de registro financeiro via WhatsApp (TXT + Ollama)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -n next,api -c cyan,green \"next dev -p 3002\" \"ts-node-dev --project tsconfig.server.json --respawn --transpile-only api/server.ts\"",
    "dev:api": "ts-node-dev --project tsconfig.server.json --respawn --transpile-only api/server.ts",
    "dev:next": "next dev",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "concurrently \"next start\" \"node dist/server.js\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "financial",
    "whatsapp",
    "ollama",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "next": "^15.2.0",
    "next-intl": "^4.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.0",
    "prisma": "^6.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
